# ============ 浙里选址 Agent 配置 ============
# 复制本文件为 .env 并填写真实值（.env 不要提交到 Git）

# ---------- 高德开放平台 Web 服务 key ----------
# 申请: https://lbs.amap.com -> 控制台 -> 创建应用 -> 添加"Web服务"类型 key
# 新版 key 需要 AMAP_SECRET 用于 SHA256 签名
AMAP_KEY=
AMAP_SECRET=

# ---------- 大模型 API（火山方舟主选，OpenAI 兼容） ----------
# 申请: https://console.volcengine.com/ark
LLM_ARK_API_KEY=
LLM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_ARK_MODEL=doubao-seed-2-1-pro-260628
LLM_ARK_MODEL_FALLBACK=doubao-seed-2-1-turbo-260628

# ---------- 备用大模型链（主模型失败时降级） ----------
# DeepSeek: https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro

LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_MODEL=deepseek-chat
