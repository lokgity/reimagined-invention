# ============ 址南针 Agent 配置 ============
# 复制本文件为 .env 并填写真实值（.env 不要提交到 Git）

# ---------- 高德开放平台 Web 服务 key ----------
# 申请: https://lbs.amap.com -> 控制台 -> 创建应用 -> 添加"Web服务"类型 key
# 新版 key 需要 AMAP_SECRET 用于 SHA256 签名
AMAP_KEY=
AMAP_SECRET=

# ---------- 大模型 API（火山方舟主选，OpenAI 兼容） ----------
# 申请: https://console.volcengine.com/ark
LLM_ARK_API_KEY=
LLM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_ARK_MODEL=doubao-seed-2-1-pro-260628
LLM_ARK_MODEL_FALLBACK=doubao-seed-2-1-turbo-260628

# ---------- 备用大模型链（主模型失败时降级） ----------
# DeepSeek: https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro

LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_MODEL=deepseek-chat

# ---------- 公网访问闸门（内网穿透 / 云部署必配） ----------
# 背景：start_agent.bat 里是 `--host 0.0.0.0`，服务一旦暴露到公网，
# 任何人都能触发服务端的付费调用（LLM + 高德），而 key 就明文放在 .env 里。
# 默认状态：**口令关闭 + 内网豁免开启** → 本地开发零影响，只对公网来访生效。
#
# 1) 访问口令：留空 = 不启用。设了之后，公网访客必须先输对口令才能对话。
#    建议给评委/测试用户单独发一个，别用自己常用的口令。
ACCESS_CODE=

# 2) 每 IP 限流：每分钟 / 每天各多少条业务消息（控制指令 ## 与 / 不计）
RATE_PER_MIN=12
RATE_PER_DAY=200

# 3) 全局日预算：整台服务当天最多跑多少条。超了当天拒答（不再调任何付费 API）。
#    这是兜底闸门 —— 就算口令泄露，损失也封顶在这里。
DAILY_BUDGET=400

# 4) 内网豁免：1 = 127.* / 192.168.* / 10.* 等内网来源不过闸门（本地开发不用输口令）
GATE_SKIP_LOCAL=1

# ⚠️ 三条如实说明（别把闸门当防盗门）：
#   · X-Forwarded-For 可被伪造，限流只防"顺手刷"，防不住刻意伪造 IP 的人；
#     要真防，在上游（穿透服务端/Nginx）限流，或开 CHAINLIT_AUTH_SECRET 登录。
#   · 计数存在 data/gate_usage.json，按天滚动、进程重启不清零，但它是单机的。
#   · 预算超了是**明确拒答**，不是降级给你一份掺沙子的结果。
